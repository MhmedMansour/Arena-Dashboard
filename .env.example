# ==============================================================================
# إعدادات اتصال Supabase للأرشيف الذكي (Mimar Smart Archive)
# انسخ هذا الملف إلى (.env.local) وضع قيم مشروعك الفعلية بداخله.
# تنبيه أمني صارم:
#   - كل متغير يبدأ بـ VITE_ يتم تضمينه في حزمة المتصفح العامة (Client-side).
#   - استخدم المفتاح العام (Publishable Key) فقط.
#   - لا تضع أبدًا Secret Key أو Service Role Key في هذا الملف أو في الواجهة الأمامية.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key_here
VITE_SUPABASE_ARCHIVE_BUCKET=mimar-archive
